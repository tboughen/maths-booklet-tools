{
  "name": "maths-booklet-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pretest": "npm run build:service",
    "test": "vitest run --exclude \"integration/**\"",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "build:service": "tsc -p tsconfig.service.json && node services/graph-mcp/build.mjs",
    "start:service": "node service-dist/cli.js",
    "test:e2e": "playwright test",
    "test:service": "npm run build:service && vitest run services/graph-mcp",
    "build:cloudflare": "tsc -b && vite build --mode cloudflare",
    "test:cloudflare": "node --test scripts/cloudflare/upload-core.test.mjs",
    "cloudflare:plan": "node scripts/cloudflare/publish.mjs plan",
    "cloudflare:upload": "node scripts/cloudflare/publish.mjs upload",
    "cloudflare:verify": "node scripts/cloudflare/publish.mjs verify-assets",
    "cloudflare:publish": "node scripts/cloudflare/publish.mjs deploy",
    "cloudflare:login": "wrangler login",
    "test:cloudflare:browser": "playwright test --project cloudflare",
    "test:website": "vitest run --exclude \"services/**\" --exclude \"integration/**\"",
    "test:catalogue": "vitest run integration/catalogue-export.test.ts",
    "test:publisher": "node --test scripts/cloudflare/*.test.mjs scripts/ci/*.test.mjs",
    "release:prepare": "node scripts/cloudflare/pipeline.mjs prepare",
    "release:check": "node scripts/cloudflare/pipeline.mjs check",
    "release:seal": "node scripts/cloudflare/pipeline.mjs seal",
    "release:qualify": "node scripts/cloudflare/pipeline.mjs qualify",
    "release:audit": "node scripts/cloudflare/promote.mjs audit",
    "release:promote": "node scripts/cloudflare/promote.mjs promote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.6.205",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "3.8.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "4.1.11",
    "@aws-sdk/client-s3": "3.1149.0",
    "wrangler": "4.149.0"
  },
  "packageManager": "npm@11.12.1"
}
