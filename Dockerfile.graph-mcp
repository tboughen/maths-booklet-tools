FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.service.json ./
COPY packages/graph-core packages/graph-core
COPY services/graph-mcp services/graph-mcp
COPY assets/graph-fonts assets/graph-fonts
RUN npm run build:service

FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
ENV NODE_ENV=production BIND_HOST=0.0.0.0 PORT=8787
WORKDIR /app
COPY services/graph-mcp/package.json services/graph-mcp/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/service-dist ./service-dist
COPY --chown=node:node assets/graph-fonts ./assets/graph-fonts
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz',{headers:{host:new URL(process.env.GRAPH_PUBLIC_URL).host}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "service-dist/cli.js"]
