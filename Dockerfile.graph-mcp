FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.service.json ./
COPY packages/graph-core packages/graph-core
COPY packages/ratio-table-core packages/ratio-table-core
COPY packages/value-graph-core packages/value-graph-core
COPY packages/cuboid-core packages/cuboid-core
COPY packages/number-line-core packages/number-line-core
COPY packages/venn-core packages/venn-core
COPY packages/algebra-grid-core packages/algebra-grid-core
COPY packages/bar-model-core packages/bar-model-core
COPY packages/chart-core packages/chart-core
COPY packages/probability-tree-core packages/probability-tree-core
COPY packages/triangle-core packages/triangle-core
COPY packages/resource-core packages/resource-core
COPY packages/diagram-core packages/diagram-core
# Package property tests share the seeded random helper, and the service typecheck covers them.
COPY src/testing/random.ts src/testing/random.ts
COPY services/graph-mcp services/graph-mcp
COPY assets/graph-fonts assets/graph-fonts
COPY assets/resource-fonts assets/resource-fonts
RUN npm run build:service

FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
ENV NODE_ENV=production BIND_HOST=0.0.0.0 PORT=8787
WORKDIR /app
COPY services/graph-mcp/package.json services/graph-mcp/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/service-dist ./service-dist
COPY --chown=node:node assets/graph-fonts ./assets/graph-fonts
COPY --chown=node:node assets/resource-fonts ./assets/resource-fonts
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["node", "service-dist/healthcheck.js"]
CMD ["node", "service-dist/cli.js"]
