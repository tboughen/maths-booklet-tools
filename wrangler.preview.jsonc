{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathsdock-preview",
  "main": "scripts/cloudflare/site-worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "preview.mathsdock.co.uk", "custom_domain": true }],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/bank/assets/*"]
  },
  "r2_buckets": [{ "binding": "BANK", "bucket_name": "maths-booklet-assets" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
